rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // CIC Items Collection
    match /cic_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // CIC Branches Collection
    match /cic_branches/{branchId} {
      allow read: if true;
      allow write: if true;
    }

    // CIC Transactions Collection
    match /cic_transactions/{txId} {
      allow read: if true;
      allow write: if true;
    }

    // CIC System Metadata (Months & Initial Baseline Stock)
    match /cic_meta/{metaId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
